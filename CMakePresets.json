{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name":"dev","displayName":"Developer Debug","generator":"Ninja","binaryDir":"${sourceDir}/build/dev","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","NEWTON_BUILD_TESTS":"ON","NEWTON_BUILD_EXAMPLES":"ON"}},
    {"name":"release","displayName":"Release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release","NEWTON_BUILD_TESTS":"ON","NEWTON_BUILD_EXAMPLES":"ON","NEWTON_BUILD_BENCHMARKS":"ON"}},
    {"name":"sanitizers","inherits":"dev","binaryDir":"${sourceDir}/build/sanitizers","cacheVariables":{"NEWTON_ENABLE_SANITIZERS":"ON"}}
  ],
  "buildPresets": [{"name":"dev","configurePreset":"dev"},{"name":"release","configurePreset":"release"},{"name":"sanitizers","configurePreset":"sanitizers"}],
  "testPresets": [{"name":"dev","configurePreset":"dev","output":{"outputOnFailure":true}},{"name":"release","configurePreset":"release","output":{"outputOnFailure":true}},{"name":"sanitizers","configurePreset":"sanitizers","output":{"outputOnFailure":true}}]
}
